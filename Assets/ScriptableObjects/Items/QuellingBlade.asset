  m_Script: {fileID: 11500000, guid: c0e775617caeabd90b27b8cebc7e4fc1, type: 3}
  m_Name: QuellingBlade
  m_EditorClassIdentifier: PudgeWars.Gameplay::PudgeWars.Gameplay.ItemDef
  displayName: Quelling Blade
  description: "\u0421\u0440\u0443\u0431\u0438\u0442\u044C \u0434\u0435\u0440\u0435\u0432\u043E (\u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 4 \u0441). +16 \u0443\u0440\u043E\u043D\u0430 \u043F\u043E \u0433\u0435\u0440\u043E\u044F\u043C, +4 \u043F\u043E \u043A\u0440\u0438\u043F\u0430\u043C"
  details: 
  abilities:
  - name: Quell
    active: 0
    description: "+16 \u0443\u0440\u043E\u043D\u0430 \u043F\u043E \u0433\u0435\u0440\u043E\u044F\u043C \u0438 +4 \u043F\u043E \u043A\u0440\u0438\u043F\u0430\u043C \u043A \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0443\u0434\u0430\u0440\u0443 \u2014 \u0430\u0442\u0430\u043A, \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439: \u0443 \u0445\u0443\u043A\u0430 \u043A \u0443\u0434\u0430\u0440\u0443 \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u0438 \u043A \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u043C\u0435\u0442\u0440\u0443, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u043F\u0440\u043E\u0442\u0430\u0449\u0438\u043B \u0446\u0435\u043B\u044C (10 + 16 = 26 \u0437\u0430 \u043C\u0435\u0442\u0440 \u043F\u043E \u0433\u0435\u0440\u043E\u044E)."
  - name: Chop Tree
    active: 1
    description: "\u0421\u0440\u0443\u0431\u0430\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E: \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043F\u0435\u043D\u044C, \u043A\u0440\u043E\u043D\u0430 \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u0435\u0442\u0441\u044F, \u0430 \u0447\u0435\u0440\u0435\u0437 20 \u0441\u0435\u043A\u0443\u043D\u0434 \u0434\u0435\u0440\u0435\u0432\u043E \u0432\u044B\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0441\u043D\u043E\u0432\u0430. \u0414\u0435\u0440\u0435\u0432\u043E, \u043F\u043E\u0441\u0430\u0436\u0435\u043D\u043D\u043E\u0435 \u0432\u0435\u0442\u043A\u043E\u0439, \u0441\u0440\u0443\u0431\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u0441\u043E\u0432\u0441\u0435\u043C. \u0415\u0441\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u043E \u0434\u0430\u043B\u044C\u0448\u0435 350, \u041F\u0443\u0434\u0436 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442 \u043A \u043D\u0435\u043C\u0443."
  lore: "\u0422\u043E\u043F\u043E\u0440 \u043F\u0430\u0432\u0448\u0435\u0433\u043E \u0433\u043D\u043E\u043C\u0430, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439 \u0441 \u043B\u0451\u0433\u043A\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u0434\u0438\u0440\u0430\u0442\u044C\u0441\u044F \u0441\u043A\u0432\u043E\u0437\u044C \u043B\u0435\u0441."
