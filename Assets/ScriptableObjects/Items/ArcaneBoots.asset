  displayName: Arcane Boots
  description: "+1.5 \u043A \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044E \u043C\u0430\u043D\u044B, +45 \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438. \u041F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435: +175 \u043C\u0430\u043D\u044B \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C \u0440\u044F\u0434\u043E\u043C"
  details: "\u0411\u043E\u043D\u0443\u0441\u044B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0441\u0430\u043F\u043E\u0433 \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
  abilities:
  - name: Replenish Mana
    active: 1
    description: "+175 \u043C\u0430\u043D\u044B \u0441\u0435\u0431\u0435 \u0438 \u0432\u0441\u0435\u043C \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 800. \u0426\u0435\u043B\u0438 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E: \u043A\u043B\u0430\u0432\u0438\u0448\u0430 \u0438\u043B\u0438 \u043A\u043B\u0438\u043A \u043F\u043E \u0441\u043B\u043E\u0442\u0443 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044E\u0442 \u0441\u0440\u0430\u0437\u0443."
