    active: 0
    description: "\u0417\u0430 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 13 % \u043C\u0430\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0431\u044B\u043B\u0430 \u0443 \u0443\u0431\u0438\u0442\u043E\u0433\u043E."
  lore: "\u0412 \u044D\u0442\u0438\u0445 \u0431\u043E\u0442\u0438\u043D\u043A\u0430\u0445 \u043C\u0430\u0433 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0431\u043E\u043B\u0435\u0435 \u0446\u0435\u043D\u043D\u044B\u043C \u0432 \u0431\u043E\u044E."
